{
	"compilerOptions": {
		"target": "es2020",
		"module": "commonjs",
		"outDir": "./dist",
		"declaration": true,
		"strict": true,
		"esModuleInterop": true,
		"sourceMap": true,
		"noUnusedLocals": true, // 禁止未使用的局部变量
		"noUnusedParameters": true, // 禁止未使用的参数
	},
	"include": [
		"src/**/*"
	],
	"exclude": ["node_modules", "dist", "examples/**/*"]
}