# mqtt
MQTT_PORT=127.0.0.1
MQTT_PORT=1888

# redis
REDIS_HOST=xxx
REDIS_PORT=6370
REDIS_USERNAME=admin
REDIS_PASSWORD=xxxx

# opentelemetry（OTLP/HTTP，默认 http://localhost:4318/v1/traces）
# 基础地址，SDK 会自动追加 /v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# 完整地址，优先级高于上面的基础地址
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# 鉴权头（多个用逗号分隔）
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer xxx
# 诊断日志级别：默认 error，排查问题时改为 debug
# OTEL_LOG_LEVEL=debug
