{
  "name": "@elfdream/mqtt5-backend",
  "version": "1.5.0",
  "description": "A cloud service based on the mqtt v5 protocol of nodejs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:commit-msg": "node --test scripts/check-commit-msg.test.js",
    "dev": "nodemon --exec tsx examples/demo.ts",
    "inspect": "tsx --inspect examples/demo.ts",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "postinstall": "simple-git-hooks",
    "tsc:check": "tsc -p tsconfig.json --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:check": "oxlint && pnpm run tsc:check"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "node ./scripts/check-commit-msg.js \"$1\"",
    "pre-push": "pnpm run fmt:check && pnpm run lint:check"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc}": [
      "oxfmt",
      "pnpm run lint:fix"
    ]
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^16.4.7",
    "lint-staged": "^17.5.1",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "ioredis": "^5.4.1",
    "ws": "^8.13.0"
  },
  "author": "XiaoMing0000",
  "license": "MIT",
  "keywords": [
    "server",
    "nodejs",
    "router",
    "mqtt",
    "TLS",
    "mqtt5",
    "mqttv5",
    "mqtt-server",
    "mqtt-broker",
    "iot",
    "backend",
    "mqtt5-backend",
    "publisher",
    "subscriber",
    "websocket",
    "wss",
    "ws"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/XiaoMing0000/mqtt5-backend.git"
  },
  "homepage": "https://gitlab.soraharu.com/xiaoming0000/mqtt5-backend"
}
